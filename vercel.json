{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/admin?action=health"
    },
    {
      "source": "/api/deploy",
      "destination": "/api/portfolio?action=deploy"
    },
    {
      "source": "/api/storage/upload-avatar",
      "destination": "/api/portfolio?action=upload-avatar"
    },
    {
      "source": "/api/storage/upload-resume",
      "destination": "/api/portfolio?action=upload-resume"
    },
    {
      "source": "/api/domain/connect",
      "destination": "/api/portfolio?action=domain-connect"
    },
    {
      "source": "/api/domain/verify",
      "destination": "/api/portfolio?action=domain-verify"
    },
    {
      "source": "/api/job/extract",
      "destination": "/api/portfolio?action=extract-job"
    },
    {
      "source": "/api/entitlements/check",
      "destination": "/api/entitlements?action=check"
    },
    {
      "source": "/api/entitlements/cooldown",
      "destination": "/api/entitlements?action=cooldown"
    },
    {
      "source": "/api/groups/manage",
      "destination": "/api/entitlements?action=group-manage"
    },
    {
      "source": "/api/promo/validate",
      "destination": "/api/entitlements?action=promo-validate"
    },
    {
      "source": "/api/audit/log",
      "destination": "/api/entitlements?action=audit-log"
    },
    {
      "source": "/api/analytics/event",
      "destination": "/api/analytics?action=event"
    },
    {
      "source": "/api/analytics/dashboard",
      "destination": "/api/analytics?action=dashboard"
    },
    {
      "source": "/api/billing/checkout",
      "destination": "/api/billing?action=checkout"
    },
    {
      "source": "/api/billing/portal",
      "destination": "/api/billing?action=portal"
    },
    {
      "source": "/api/billing/webhook",
      "destination": "/api/billing?action=webhook"
    },
    {
      "source": "/api/public/portfolio",
      "destination": "/api/public?action=resume&resource=portfolio"
    },
    {
      "source": "/api/public/resume",
      "destination": "/api/public?action=resume"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/public?action=reset-password"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/public?action=auth-signup"
    },
    {
      "source": "/api/auth/resend",
      "destination": "/api/public?action=auth-resend"
    },
    {
      "source": "/api/auth/check-email",
      "destination": "/api/public?action=auth-check-email"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/u/:username/:variantSlug",
      "destination": "/index.html"
    },
    {
      "source": "/u/:username",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
