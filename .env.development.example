# Copy to .env.development.local. Never put Production credentials here.
VITE_LOCAL_DEV_MODE=true
VITE_SUPABASE_ENV=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-dev-anon-key
VITE_FF_CAREER_STUDIO=true
VITE_LOCAL_AUTH_MOCK=true

# Server-only local acceptance override; never a commercial pricing setting.
CV_FREE_EXPORT_LIMIT=2

# If using a separate hosted Development project, set VITE_SUPABASE_ENV=development
# and use only that project's publishable/anon key. Never add service-role keys.
